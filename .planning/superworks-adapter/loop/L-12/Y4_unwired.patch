+# Non-numeric terminal names admitted only when the project's SuperWORKS metadata
+# names them (see build_endpoint_lexicon). They travel the schematic semantic
+# endpoint channel, so pairs.py keeps them only beside a numeric opposite side.
+_SW_LEXICON_TERMINAL_DETAIL = "sw_endpoint_lexicon_terminal"
+_SW_LEXICON_MAX_ROW_OFFSET = 3.0
+_SW_LEXICON_MIN_LENGTH = 2
+# Alarm/contact function labels, e.g. "系统告警(NO3)": SuperWORKS stores them as
+# connect-label pin names, but they name a signal, not a terminal, so they stay out.
+_SW_FUNCTION_LABEL_PATTERN = re.compile(r"\((?:NO|NC)\d+\)$", re.IGNORECASE)
+# Connect-label identities read "<device>-<pin>", e.g. "1-26n-COM1" -> pin "COM1".
+_SW_DEVICE_PIN_IDENTITY_PATTERN = re.compile(r"^\d+-\d+n-(?P<pin>.+)$", re.IGNORECASE)
+_SW_LEXICON_EXCLUDED_PORT_CATEGORIES = frozenset({"内部元件"})
+_SW_ENDPOINT_DECORATION_PATTERN = re.compile(r"^[\s&*]+|[\s&*]+$")
+
+
+def _lexicon_key(value: object) -> str:
+    if isinstance(value, dict):
+        value = value.get("value") or value.get("normalized") or ""
+    text = re.sub(r"\s+", " ", str(value or "")).strip()
+    return _SW_ENDPOINT_DECORATION_PATTERN.sub("", text)
+
+
+def build_endpoint_lexicon(superworks: object) -> frozenset[str]:
+    """Terminal names a project's SuperWORKS metadata already identifies.
+
+    Sources: strip-row endpoint identities, port endpoint identities and their
+    label/pin aliases (internal component ports excluded), and connect-label
+    values plus device pin names. Function labels are dropped by pattern.
+    """
+
+    names: set[str] = set()
+
+    def add(value: object) -> None:
+        key = _lexicon_key(value)
+        if key and not _SW_FUNCTION_LABEL_PATTERN.search(key):
+            names.add(key)
+
+    def add_identity(identity: object) -> None:
+        key = _lexicon_key(identity)
+        if not key:
+            return
+        add(key)
+        match = _SW_DEVICE_PIN_IDENTITY_PATTERN.fullmatch(key)
+        if match:
+            add(match.group("pin"))
+
+    for row in getattr(superworks, "strip_rows", None) or []:
+        add_identity(getattr(row, "endpoint_identity", None))
+    for port in getattr(superworks, "ports", None) or []:
+        if getattr(port, "category", "") in _SW_LEXICON_EXCLUDED_PORT_CATEGORIES:
+            continue
+        identity = _lexicon_key(getattr(port, "endpoint_identity", None))
+        add_identity(identity)
+        label = _lexicon_key(getattr(port, "label", None))
+        # A label that only prefixes its own identity ("1-26n" for "1-26n1201") is the device.
+        if not (label and identity.startswith(label) and identity != label):
+            add(label)
+        add(getattr(port, "pin", None))
+    for label in getattr(superworks, "connect_labels", None) or []:
+        add(getattr(label, "text", None))
+        add_identity(getattr(label, "endpoint_identity", None))
+    return frozenset(name for name in names if len(name) >= _SW_LEXICON_MIN_LENGTH)
+
+
+def _lexicon_terminal_value(text: TextItem, lexicon: frozenset[str]) -> str | None:
+    key = _lexicon_key(text.normalized_text)
+    if len(key) < _SW_LEXICON_MIN_LENGTH or key not in lexicon:
+        return None
+    if _SW_FUNCTION_LABEL_PATTERN.search(key):
+        return None
+    return key
 
 
