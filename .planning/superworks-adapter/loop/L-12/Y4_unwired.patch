+def _scope_lexicon_terminal_candidates(
+    left: list[TerminalCandidate],
+    right: list[TerminalCandidate],
+) -> tuple[list[TerminalCandidate], list[TerminalCandidate]]:
+    """SuperWORKS-named terminal text fills only a side with no numeric terminal."""
+    left_has_numeric = any(item.channel == _CHANNEL_TERMINAL_NUMERIC for item in left)
+    right_has_numeric = any(item.channel == _CHANNEL_TERMINAL_NUMERIC for item in right)
+    if left_has_numeric:
+        left = [item for item in left if item.channel_detail != _SW_LEXICON_TERMINAL_DETAIL]
+    if right_has_numeric:
+        right = [item for item in right if item.channel_detail != _SW_LEXICON_TERMINAL_DETAIL]
+    return left, right
