+def _is_label_bound_to_other_line_endpoint(
+    text: TextItem,
+    group: LineGroup,
+    endpoint: tuple[float, float],
+    line_endpoints: _LineEndpointIndex,
+) -> bool:
+    anchor = (text.insert_x, text.insert_y)
+    own_distance = math.hypot(anchor[0] - endpoint[0], anchor[1] - endpoint[1])
+    radius = _LABEL_OTHER_LINE_ENDPOINT_MAX_HEIGHT_MULTIPLE * text.height
+    foreign_distance = line_endpoints.nearest_foreign_distance(anchor, group.line_group_id, radius)
+    if foreign_distance is None:
+        return False
+    return foreign_distance <= radius and foreign_distance <= own_distance * _LABEL_OTHER_LINE_ENDPOINT_MAX_OWN_RATIO
