+# A numeric label is bound to another line when that line's endpoint is much closer to
+# the label anchor than the candidate's own endpoint, and close in absolute terms.
+_LABEL_OTHER_LINE_ENDPOINT_MAX_OWN_RATIO = 1.0 / 3.0
+_LABEL_OTHER_LINE_ENDPOINT_MAX_HEIGHT_MULTIPLE = 1.5
+
+
+class _LineEndpointIndex:
+    """Endpoints of one sheet's line groups, used to find a foreign endpoint near a text anchor."""
+
+    def __init__(self, groups: list[LineGroup]) -> None:
+        self.points: list[tuple[float, float, str]] = []
+        for group in groups:
+            self.points.append((group.start_x, group.start_y, group.line_group_id))
+            self.points.append((group.end_x, group.end_y, group.line_group_id))
+        self.tree = STRtree([Point(x, y) for x, y, _ in self.points]) if self.points else None
+
+    def nearest_foreign_distance(
+        self,
+        anchor: tuple[float, float],
+        line_group_id: str,
+        radius: float,
+    ) -> float | None:
+        """Distance to the nearest endpoint of a single other line group within radius.
+
+        Returns None when no foreign endpoint is within radius, or when two or more
+        distinct foreign groups have endpoints within radius (a shared numeric anchor).
+        """
+        if self.tree is None or radius <= 0:
+            return None
+        ax, ay = anchor
+        best: float | None = None
+        owners: set[str] = set()
+        for index in self.tree.query(box(ax - radius, ay - radius, ax + radius, ay + radius)):
+            x, y, owner = self.points[int(index)]
+            if owner == line_group_id:
+                continue
+            distance = math.hypot(ax - x, ay - y)
+            if distance > radius:
+                continue
+            owners.add(owner)
+            if best is None or distance < best:
+                best = distance
+        if len(owners) != 1:
+            return None
+        return best
